[user]
	name = minierparedes
	email = 3thancr0wn@gmail.com
	signingkey = 0CB99DCB47D459A55DA9A856E2F1B92117913BDD

[credential]
	helper = osxkeychain

[init]
	defaultBranch = main

[core]
	excludesFile = /Users/minierparedes/.config/git/ignore
	compression = 9
	whitespace = error
	preloadIndex = true
	precomposeUnicode = true
	pager = delta

[delta]
    navigate = true
    side-by-side = true

[interactive]
    diffFilter = delta --color-only

[commit]
	gpgsign = true

[push]
	default = current

	autoSetupRemote = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram

[rerere]
	enabled = true

[gpg]
	program = gpg

[agent]
    allow-loopback-pinentry = true

[color]
	ui = true
