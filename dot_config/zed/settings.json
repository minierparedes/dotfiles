{
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 16,
  "buffer_font_size": 16,
   "ui_font_family": ".ZedMono",
  "buffer_font_family": ".ZedMono",
  "buffer_line_height": { "custom": 1.2 },
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "SynthWave 84 Dark",
  },
  "icon_theme":"Catppuccin Mocha",
  "project_panel": {
    "dock": "left",
    "entry_spacing": "comfortable",
    "auto_fold_dirs": false,
    "scrollbar": {"show": "never"},
  },
  "tabs": { "file_icons": true },
  "autosave": "on_focus_change",
  "tab_size": 4,
  "title_bar": {
    "show_project_items": false,
    "show_branch_name": false,
  },
  "file_finder": {"modal_max_width": "large" },
  "scrollbar": {"show": "never" },
  "gutter": {"min_line_number_digits": 0 },
  "drag_and_drop_selection": {"enabled": false },
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": false,
  "auto_update": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
}
